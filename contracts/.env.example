# Copy to .env and fill in (never commit .env)
DEPLOYER_PK=            # EVM deployer private key (MetaMask export) — EVM-surface scripts only
PORTALDOT_TESTNET_RPC=https://test-evm-rpc-v3.portaldot.dev
PORTALDOT_LOCAL_RPC=    # optional local node EVM RPC, default http://127.0.0.1:8545

# Native-surface deploy (scripts/native-deploy.cjs) instead reads native-wallet.json
# (sr25519 mnemonic, gitignored) — see docs/DEPLOYMENT.md for why native is ~10,000x cheaper here.
